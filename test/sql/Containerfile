FROM docker.io/library/golang:1.27.3-trixie@sha256:7b072c590a326b9d2a43b165ae247f6e8eafff32e1ad154ab97139e89f053be9 AS builder
COPY debian.sources /etc/apt/public.sources
RUN apt-get -o Dir::Etc::sourcelist=/etc/apt/public.sources -o Dir::Etc::sourceparts=- -o APT::Update::Error-Mode=any update \
    && apt-get -o Dir::Etc::sourcelist=/etc/apt/public.sources -o Dir::Etc::sourceparts=- install -y --no-install-recommends libevent-dev libssl-dev pkg-config
WORKDIR /src
RUN curl --proto '=https' --tlsv1.3 -fsSL https://github.com/pgbouncer/pgbouncer/releases/download/pgbouncer_1_26_1/pgbouncer-1.26.1.tar.gz -o source.tar.gz \
    && echo '00886a2994b4844cd37110970df777772cfc42a74c400522c82fba509a3f42d9  source.tar.gz' | sha256sum -c - \
    && tar -xzf source.tar.gz \
    && cd pgbouncer-1.26.1 \
    && ./configure --prefix=/opt/pgbouncer \
    && make -j2 pgbouncer

FROM docker.io/library/postgres:18.6-trixie@sha256:979bccfde35445db618c65107d27d08c6c21339d8dc3ad4c830c6633947be0e4
COPY debian.sources /etc/apt/public.sources
RUN apt-get -o Dir::Etc::sourcelist=/etc/apt/public.sources -o Dir::Etc::sourceparts=- -o APT::Update::Error-Mode=any update \
    && apt-get -o Dir::Etc::sourcelist=/etc/apt/public.sources -o Dir::Etc::sourceparts=- install -y --no-install-recommends libevent-2.1-7t64
COPY --from=builder /src/pgbouncer-1.26.1/pgbouncer /usr/local/bin/pgbouncer
USER postgres
ENTRYPOINT ["/usr/bin/env", "-i", "PATH=/usr/local/bin:/usr/lib/postgresql/18/bin:/usr/bin:/bin", "HOME=/tmp", "LANG=C.UTF-8", "/usr/local/bin/pooler.test"]
